{
  "name": "@daphne/pr-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./split": {
      "types": "./dist/split.d.ts",
      "import": "./dist/split.js"
    },
    "./intentions": {
      "types": "./dist/intentions.d.ts",
      "import": "./dist/intentions.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@daphne/git-source": "workspace:*",
    "@daphne/review-evidence": "workspace:*",
    "@daphne/context-engine": "workspace:*",
    "@daphne/intentions": "workspace:*",
    "@daphne/semantic-split": "workspace:*"
  }
}
