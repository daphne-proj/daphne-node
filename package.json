{
  "name": "daphne-node",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.22.0 <25",
    "bun": "1.4.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "bun run build && tsc --noEmit -p tsconfig.tools.json && bun run --filter \"@daphne/*\" typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "bun run build && vitest run",
    "test:watch": "bun run build && vitest",
    "cli": "node apps/cli/dist/main.js",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "trustedDependencies": []
}
