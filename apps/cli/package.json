{
  "name": "@daphne/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./output-path": {
      "types": "./dist/output-path.d.ts",
      "import": "./dist/output-path.js"
    },
    "./command-output": {
      "types": "./dist/command-output.d.ts",
      "import": "./dist/command-output.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@daphne/pr-review": "workspace:*",
    "@daphne/git-source": "workspace:*",
    "@daphne/review-evidence": "workspace:*",
    "@daphne/context-engine": "workspace:*",
    "@daphne/llm": "workspace:*"
  }
}
